{
    "title": "AIShot",
    "rules": [
        {
            "description": "AI Screenshot: cmd+shift+2 launches AIShot (capture, then paste into frontmost AI app)",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "2",
                        "modifiers": { "mandatory": ["command", "shift"] }
                    },
                    "to": [{ "shell_command": "open -gnb space.techjuicelab.aishot" }]
                }
            ]
        },
        {
            "description": "AI Screenshot: cmd+shift+6 launches AIShot scrolling capture (full page, then paste into the AI app)",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "6",
                        "modifiers": { "mandatory": ["command", "shift"] }
                    },
                    "to": [{ "shell_command": "open -nb space.techjuicelab.aishot --args --scroll" }]
                }
            ]
        },
        {
            "description": "AI Screenshot: left shift + right shift together launches AIShot (Codex-style)",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "simultaneous": [
                            { "key_code": "left_shift" },
                            { "key_code": "right_shift" }
                        ],
                        "simultaneous_options": { "key_down_order": "insensitive" }
                    },
                    "to": [{ "shell_command": "open -gnb space.techjuicelab.aishot" }]
                }
            ]
        }
    ]
}
